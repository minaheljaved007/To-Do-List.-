# Copy this file to .env and fill in your real values from your Supabase project.
# Dashboard -> Project Settings -> API
#
# For local development with `streamlit run app.py`, you'll export these
# as real environment variables (see README instructions) rather than
# relying on python-dotenv, since task_manager.py reads os.environ directly.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_KEY=YOUR-ANON-PUBLIC-KEY
