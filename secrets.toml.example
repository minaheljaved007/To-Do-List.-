# Copy this to .streamlit/secrets.toml locally for testing with real
# Streamlit secrets (optional — env vars also work locally).
#
# On Streamlit Community Cloud, DO NOT upload this file. Instead, paste
# these same two lines into your app's Settings -> Secrets in the
# web dashboard. Never commit real credentials to GitHub.

SUPABASE_URL = "https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_KEY = "YOUR-ANON-PUBLIC-KEY"
